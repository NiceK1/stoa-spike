{
  "name": "blueline-api",
  "is_spot": false,
  "container_registry_settings": {
    "is_private": true,
    "credentials": { "name": "<REGISTRY_CREDENTIALS_NAME>" }
  },
  "compute": { "name": "CPU Node", "size": 8 },
  "scaling": {
    "min_replica_count": 1,
    "max_replica_count": 8,
    "concurrent_requests_per_replica": 1,
    "queue_message_ttl_seconds": 300,
    "scale_up_policy": { "delay_seconds": 0 },
    "scale_down_policy": { "delay_seconds": 300 },
    "scaling_triggers": {
      "queue_load": { "threshold": 1 },
      "cpu_utilization": { "enabled": false, "threshold": 80 },
      "gpu_utilization": { "enabled": false, "threshold": 80 }
    }
  },
  "containers": [
    {
      "image": "vccr.io/<PROJECT_ID>/blueline:<TAG>",
      "exposed_port": 7860,
      "healthcheck": { "enabled": true, "port": 7860, "path": "/api/health" },
      "env": [
        { "type": "plain", "name": "HOST", "value_or_reference_to_secret": "0.0.0.0" },
        { "type": "plain", "name": "PORT", "value_or_reference_to_secret": "7860" },
        { "type": "plain", "name": "VISION_PROVIDER", "value_or_reference_to_secret": "none" },
        { "type": "plain", "name": "DETECTOR", "value_or_reference_to_secret": "onnx" },
        { "type": "plain", "name": "RASTER_DETECTOR_TARGETS", "value_or_reference_to_secret": "all" },
        { "type": "plain", "name": "RASTER_SYMBOL_VOTE", "value_or_reference_to_secret": "off" },
        { "type": "plain", "name": "PLANNER_PROVIDER", "value_or_reference_to_secret": "gemma-local" },
        { "type": "plain", "name": "PLANNER_THREADS", "value_or_reference_to_secret": "8" },
        { "type": "plain", "name": "DETECTOR_THREADS", "value_or_reference_to_secret": "8" }
      ],
      "volume_mounts": [
        { "type": "scratch", "mount_path": "/home/node/space/app/.cache" }
      ]
    }
  ]
}
